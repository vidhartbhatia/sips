{
  "name": "sips",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Sips: a Seattle cafe journal (oursips.com). Next.js 16, React 19, Supabase.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "prepare": "git config core.hooksPath .githooks || true",
    "test:e2e": "playwright test",
    "test": "vitest run",
    "verify": "rm -rf .next/types .next/dev/types && next typegen && tsc --noEmit && eslint && vitest run && next build"
  },
  "dependencies": {
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.99.2",
    "framer-motion": "^12.38.0",
    "mapbox-gl": "^3.20.0",
    "next": "16.4.6",
    "next-mdx-remote": "^6.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-dropzone": "^15.0.0",
    "react-map-gl": "^8.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "^0.5.16",
    "@mdx-js/mdx": "^3.1.1",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
