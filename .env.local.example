# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Mapbox
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1...

# Map provider: "mapbox" or "leaflet"
NEXT_PUBLIC_MAP_PROVIDER=mapbox

# Google Maps API
# Browser/public key — used by any client-side Google Maps JS (currently unused;
# Mapbox powers /map). MUST be restricted in GCP console: HTTP referrer allowlist
# (oursips.com, *.vercel.app, localhost) + API allowlist (Maps JavaScript / Places
# only) + low daily quota cap.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIza...

# Server-only geocoding key — no NEXT_PUBLIC_ prefix so it never ships to the
# browser. Used by lib/google/geocode.ts. Restrict in GCP console to Geocoding
# API only with a low daily quota cap (~500/day for sips).
GOOGLE_GEOCODING_API_KEY=AIza...

# Auth allowlist — comma-separated emails permitted to sign in via magic link.
# Required: middleware and Server Actions reject any user not in this list.
ALLOWED_EMAILS=you@example.com,partner@example.com
