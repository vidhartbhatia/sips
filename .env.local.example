# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Mapbox
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1...

# Map provider: "mapbox" or "leaflet"
NEXT_PUBLIC_MAP_PROVIDER=mapbox

# Google Maps API
# Browser/public key — reserved for client-side Google Maps/Places JS. Currently
# UNUSED by the code (Mapbox powers /map; nothing reads this var). Restricted in
# GCP to referrers oursips.com, www.oursips.com, localhost:3000 (NOT *.vercel.app,
# so it would fail on preview deploys) + Maps JavaScript / Places APIs only.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIza...

# Server-only geocoding key — no NEXT_PUBLIC_ prefix so it never ships to the
# browser. Used by lib/google/geocode.ts (cafe create/update). Restricted in GCP
# to the Geocoding API only. No fallback to the browser key.
GOOGLE_GEOCODING_API_KEY=AIza...

# Auth allowlist — comma-separated emails permitted to sign in via magic link.
# Required: middleware and Server Actions reject any user not in this list.
ALLOWED_EMAILS=you@example.com,partner@example.com
