#!/bin/sh
# Blocks commit messages containing personal emails (for example a Co-authored-by trailer with a
# real address). GitHub noreply and bot noreply addresses are fine.
msg_file="$1"
bad=$(grep -v '^#' "$msg_file" | grep -oE '[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+(\.[A-Za-z0-9-]+)*\.[A-Za-z]{2,}' \
  | grep -viE '@(users\.noreply\.github\.com|anthropic\.com|example\.com)$|^noreply@' | sort -u)
if [ -n "$bad" ]; then
  printf '\n\033[31m✖ commit blocked:\033[0m commit message contains a personal email: %s\n   Use the person'"'"'s GitHub noreply address.\n\n' "$(printf '%s' "$bad" | sed -E 's/^(.).*@/\1***@/' | tr '\n' ' ')" >&2
  exit 1
fi
exit 0
